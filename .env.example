# Copy to .env.local and fill in. Never commit real values.
#
# Server-side only. Note there is deliberately no VITE_ prefix: any VITE_-prefixed
# variable is inlined into the public client bundle at build time, which is how this
# key was exposed before the 2026-07-01 fix.
GEMINI_API_KEY=

# Optional. Overrides the Gemini image model. Defaults to gemini-3.1-flash-lite-image.
# Google retires image models periodically (all Imagen models were shut down on
# 2026-08-17, which surfaced as a 404 NOT_FOUND on every request) — setting this lets
# you move to a live model without a code change.
#
# Measured on production: lite generates in ~3.0s, gemini-3.1-flash-image in ~8.8s.
# Generation is ~95% of the request's wall clock, so this dominates how the page feels.
IMAGE_MODEL=

# Optional. Output shape and resolution. Default 1:1 at 1K, which matches the roughly
# square panel the image is displayed in. 16:9 gets cropped by object-cover, so it costs
# bytes for pixels nobody sees. Sizes are 512px / 1K / 2K / 4K — uppercase K is required,
# and not every model supports every size (lite is 1K only).
IMAGE_ASPECT_RATIO=
IMAGE_SIZE=

# Optional. Comma-separated origins allowed to call /api/generate-image.
# Defaults to same-origin when unset. The canonical origin is:
# ALLOWED_ORIGIN=https://ae27.gusddev.app
ALLOWED_ORIGIN=
